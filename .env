# 파이프라인 튜너블 — 코드 수정 없이 여기만 바꿔서 재실행.
# (llm/config.py 가 읽는다. 프롬프트는 llm/prompts/*.md 에 있음.)

# 분석에 쓸 ollama 로컬 모델.
#   현재:      qwen3.8:27b-mtp-q4_K_M (Apache 2.0, 18GB — MTP 내장 태그, T4 같은 대역폭 굶주린 카드에서 디코드 가속)
#   주의: 18GB + KV 캐시라 T4 16GB×2 에선 KV q4_0 필수 (kaggle 노트북이 OLLAMA_KV_CACHE_TYPE=q4_0 설정).
#   베이크오프 후보 (32GB VRAM / 라이선스 clean):
#     qwen3.8:27b-q4_K_M    (Apache 2.0,     17GB — MTP 태그가 문제일 때 폴백)
#     gemma4:26b            (직전 사용 모델)
#     mistral-small3.2:24b  (Apache 2.0,     ~15GB Q4)
#     phi4:14b              (MIT,            ~9GB  Q4)
MODEL=qwen3.8:27b-mtp-q4_K_M

# 컨텍스트 크기 (tier1 주입 + 보고서까지 여유). 프롬프트 축소 + 크게 잡아 evidence 안 잘리게.
#   VRAM 부족하면 낮추고, 넉넉하면 131072 까지 올려도 됨.
NUM_CTX=65536

# 추론(thinking) 모드 — qwen3.8 은 추론이 본체(동급 1위는 thinking 켠 점수). 끄면 광고를 IOC 로
#   올리고 Shellshock 서사를 놓치는 식의 판단 실패가 난다(q2 실측). ollama 는 low/medium 을 못 넘기므로
#   켬(xhigh)/끔 둘뿐. 느리면(pcap 당 수십 분) 여기 false 로 — 단, think=false 는 ollama 의
#   format(스키마) 무시 버그 이력이 있어 노트북 진단 셀의 'format 강제 OK' 를 확인할 것.
THINK=true

# 샘플링 — qwen3.8 모델카드 권장: thinking 1.0/0.95, instruct(THINK=false) 0.7/0.8.
#   (gemma4 시절 0.3 은 qwen 계열에서 반복 루프 경향. seed 고정으로 재현성은 유지.)
TEMPERATURE=1.0
TOP_P=0.95
SEED=42
