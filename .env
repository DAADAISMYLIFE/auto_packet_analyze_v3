# 파이프라인 튜너블 — 코드 수정 없이 여기만 바꿔서 재실행.
# (llm/config.py 가 읽는다. 프롬프트는 llm/prompts/*.md 에 있음.)

# 분석에 쓸 ollama 로컬 모델 — **공식 표준 태그만** (커뮤니티 양자화·비표준 태그 금지, 2026-09-02 P100 사고).
#   현재: qwen3.8:27b (18GB q4_K_M, 256K ctx, thinking 레벨 지원). T4 16GB×2 분산, KV q8_0 (노트북 설정).
#   측정: forensic ≈17~21분/케이스 (decode 12.8 tok/s, 사고가 벽시계의 ~75%). docs/MEASUREMENTS.md.
# ── 모델 교체 시 체크리스트 ──
#   · 요건은 tool 지원이 아니라 format(구조화 출력) 지원. thinking 미지원 모델은 run.py 의 think 파라미터에 400 → 코드 수정 필요.
#   · ctx: q2 tier1 은 최대 강등 후에도 ≈31k 토큰 → NUM_CTX×0.6 ≥ 31k 이어야 forensic 이 돈다 (즉 ctx ≥ 52k).
#     이 산수로 qwen3:14b(40k)·phi4:14b(16k) 는 돌리기 전에 기각됐다 (2026-09-03).
#   · 판정 기준은 돌리기 '전에' 적는다. 정밀도(iocP/domP)만 보는 기준은 "아무것도 안 찾는 모델"을 못 거른다 —
#     30b-thinking 이 그렇게 글자로는 통과하고 실질 탈락했다 (LLM 자력 IOC 0, 서술 사실오류 3). 기준에 iocR 델타와
#     서술 사실오류 0 을 넣을 것.
#   · 실험 카드 (탈락, 참고용): MODEL=qwen3:30b-thinking  THINK=true  THINK_NARRATIVE=true  TEMPERATURE=0.6  NUM_PREDICT=24000
MODEL=qwen3.8:27b

# 컨텍스트 크기. tier1 이 안 들어가면 ollama 가 잘라주는 게 아니라 user 메시지를 통째로 버린다
#   ("no user query found in messages" 500, 12분 태운 뒤). q2 tier1 은 qwen 토크나이저(숫자 1자=1토큰) 기준
#   136k 토큰이었고, 신호 우선 캡 + 뷰 강등으로 ≈31k 까지 줄여 NUM_CTX×0.6 예산 안에 넣는다.
#   run.py 가 호출 '전'에 tier1 크기 vs 예산을 찍고, 최대 강등 후에도 넘치면 호출하지 않는다.
NUM_CTX=131072

# 추론 강도 — ollama 가 qwen3.8 전용 렌더러로 지원 (true/false/low/medium/high).
#   true·high = xhigh 지침 주입(최대 사고 — 지금까지 이 상태로 케이스당 15~20분)
#   medium    = 지침 없음(모델 본연 판단). 복잡 과제 실측: 사고 40~60% 절감, 완성도 소폭↓
#   low       = 복잡 과제에서 토큰 폭증 + 자가검증 루프 실측 — 포렌식엔 쓰지 마라
#   false     = 사고 끔 = 판단력 급감(gemma화) — 쓰지 마라
# 실측(2026-09-02): xhigh↔medium 벽시계 차이 없음(사고 21.6k↔27~28.7k자) — 레벨은 속도 지렛대가 아니다.
# ※ 레벨 문자열(low/medium/high)은 qwen3.8 렌더러 전용 — qwen3:30b-thinking 은 true 만 받는다.
THINK=medium
# 서술(render_report)은 요약이라 사고 불필요. (thinking 전용 모델(30b-thinking)은 true 강제.
#  파싱 실패 시 자동으로 think=true 1회 재시도)
THINK_NARRATIVE=false

# 샘플링 — 모델카드 권장값을 따른다: qwen3-thinking-2507 은 0.6/0.95/20,
#   qwen3.8 은 thinking 1.0/0.95, instruct(THINK=false) 0.7/0.8. (27b 복귀 시 1.0 으로.)
#   (gemma4 시절 0.3 은 qwen 계열에서 반복 루프 경향. seed 고정으로 재현성은 유지.)
TEMPERATURE=1.0
TOP_P=0.95
SEED=42

# 생성 상한(사고+출력 합) — 폭주 차단기. 27b 정상 실측 ≈11k. 낮추면 본답이 잘린다(#14793).
#   qwen3:30b-thinking 은 사고가 긴 종이라 24000 (27b 복귀 시 16000).
NUM_PREDICT=16000
# 샘플링 보강 — qwen3.8 모델카드 권장 top_k 20 (ollama 기본 40)
TOP_K=20
