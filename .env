# 파이프라인 튜너블 — 코드 수정 없이 여기만 바꿔서 재실행.
# (llm/config.py 가 읽는다. 프롬프트는 llm/prompts/*.md 에 있음.)

# 분석에 쓸 ollama 로컬 모델.
#   현재:      qwen3.8:27b-mtp-q4_K_M (Apache 2.0, 18GB — MTP 내장 태그, T4 같은 대역폭 굶주린 카드에서 디코드 가속)
#   주의: 18GB + KV 캐시라 T4 16GB×2 에선 KV q4_0 필수 (kaggle 노트북이 OLLAMA_KV_CACHE_TYPE=q4_0 설정).
#   베이크오프 후보 (32GB VRAM / 라이선스 clean):
#     qwen3.8:27b-q4_K_M    (Apache 2.0,     17GB — MTP 태그가 문제일 때 폴백)
#     gemma4:26b            (직전 사용 모델)
#     mistral-small3.2:24b  (Apache 2.0,     ~15GB Q4)
#     phi4:14b              (MIT,            ~9GB  Q4)
# 공식 표준 태그 (T4 x2). -mtp 변형·커뮤니티 양자화 실험은 2026-09-02 정리 — 표준으로 통일.
# ── 밤 배치 베이크오프 (성질머리 합의 TOP2) — 판정 기준을 돌리기 전에 박는다:
#   "코드 바닥(floor) 대비 우위 AND 27b 대비 iocP/domP -5%p 이내면 개발 루프 모델로 채택,
#    27b 는 최종 회귀표 전용으로 강등." 개발용 모델 ≠ 최종 보고용 모델 (정당한 분리).
# 2026-09-03 재판정: 원래 밤1(qwen3:14b@32k)·밤2(phi4:14b@16k)는 실측 기각 —
#   q2 tier1 = 31,120 토큰(최대 강등 후)인데 두 모델 최대 ctx(40k/16k)의 0.6 예산에 안 들어감.
#   gemma3:12b 는 128k ctx 지만 thinking 미지원 → run.py 의 think 파라미터에 400 (코드 수정 필요).
#   → 밤 카드 = qwen3:30b-thinking (공식 태그, 19GB, 256K ctx, MoE 활성 3B → 디코드 가속이 목적).
#   이 모델은 사고를 '끌 수 없고' think 레벨 문자열(qwen3.8 렌더러 전용)도 안 받는다
#   → THINK=true / THINK_NARRATIVE=true 필수 (false·medium 은 400).
# 2026-09-03 밤 = 베이크오프가 아니라 **시그니처 제거 ablation**(노트북 ABLATION=True):
#   "LLM 이 필요한가"가 "어느 모델이 빠른가"보다 앞선 질문. 교란 변수 제거를 위해 검증된 27b 로 돈다.
#   30b-thinking 카드: MODEL=qwen3:30b-thinking  THINK=true  THINK_NARRATIVE=true  TEMPERATURE=0.6  NUM_PREDICT=24000
MODEL=qwen3.8:27b

# 컨텍스트 크기. tier1 이 안 들어가면 ollama 가 잘라주는 게 아니라 user 메시지를 통째로 버린다
#   ("no user query found in messages" 500) — q2 tier1 ≈ 84k 토큰이라 65536 에선 그 에러가 났다.
#   qwen3.8 27B 의 KV 는 작다(T4 실측: 65k 에서 카드당 9.8GB) → 131072 도 32GB 에 들어간다.
#   run.py 가 호출 전에 tier1 크기 vs NUM_CTX 를 찍어준다. 근본 해결은 http body 예산(README 한계 #3).
NUM_CTX=131072

# 추론 강도 — ollama 가 qwen3.8 전용 렌더러로 지원 (true/false/low/medium/high).
#   true·high = xhigh 지침 주입(최대 사고 — 지금까지 이 상태로 케이스당 15~20분)
#   medium    = 지침 없음(모델 본연 판단). 복잡 과제 실측: 사고 40~60% 절감, 완성도 소폭↓
#   low       = 복잡 과제에서 토큰 폭증 + 자가검증 루프 실측 — 포렌식엔 쓰지 마라
#   false     = 사고 끔 = 판단력 급감(gemma화) — 쓰지 마라
# medium 으로 A/B 중: 직전 xhigh 결과가 reports/forensic_raw 캐시에 있어 truth 대조 가능.
# ※ 레벨 문자열(low/medium/high)은 qwen3.8 렌더러 전용 — qwen3:30b-thinking 은 true 만 받는다.
THINK=medium
# 서술(render_report)은 요약이라 사고 불필요. (thinking 전용 모델(30b-thinking)은 true 강제.
#  파싱 실패 시 자동으로 think=true 1회 재시도)
THINK_NARRATIVE=false

# 샘플링 — 모델카드 권장값을 따른다: qwen3-thinking-2507 은 0.6/0.95/20,
#   qwen3.8 은 thinking 1.0/0.95, instruct(THINK=false) 0.7/0.8. (27b 복귀 시 1.0 으로.)
#   (gemma4 시절 0.3 은 qwen 계열에서 반복 루프 경향. seed 고정으로 재현성은 유지.)
TEMPERATURE=1.0
TOP_P=0.95
SEED=42

# 생성 상한(사고+출력 합) — 폭주 차단기. 27b 정상 실측 ≈11k. 낮추면 본답이 잘린다(#14793).
#   qwen3:30b-thinking 은 사고가 긴 종이라 24000 (27b 복귀 시 16000).
NUM_PREDICT=16000
# 샘플링 보강 — qwen3.8 모델카드 권장 top_k 20 (ollama 기본 40)
TOP_K=20
